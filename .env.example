# Your actual hostname, or public IP when using compose.ip-https.yaml.
SITE_DOMAIN=
# Generate locally with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
STUDIO_ACCESS_TOKEN=
# One owner only. Do not distribute this token in a public Play Store app.
STUDIO_GEMINI_MODEL=gemini-2.5-flash
STUDIO_WHISPER_MODEL=tiny
# Optional stock transfer limits, in MiB. Oversized assets are skipped, not fatal.
# STUDIO_STOCK_ASSET_MB=40
# STUDIO_STOCK_TOTAL_MB=192
# Add the exact deployed Vercel origin, preserving any other origins you use.
# STUDIO_CORS_ORIGINS=https://YOUR_ACTUAL_PROJECT.vercel.app,https://localhost,http://localhost,capacitor://localhost
